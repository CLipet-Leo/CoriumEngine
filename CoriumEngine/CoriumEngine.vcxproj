  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Shaders HLSL compilés par DXC (vcpkg directx-dxc) en DXIL (.cso) et SPIR-V (.spv) à côté de
       l'exe. Convention : points d'entrée VSMain/PSMain. Après ClCompile car vcpkg installe dxc
       juste avant ClCompile. -->
  <PropertyGroup>
    <DxcExe>$(SolutionDir)vcpkg_installed\x64-windows\tools\directx-dxc\dxc.exe</DxcExe>
    <DxcFlags Condition="'$(Configuration)'=='Debug_DX12'">-Zi -Qembed_debug -Od</DxcFlags>
    <DxcFlags Condition="'$(Configuration)'!='Debug_DX12'">-O3</DxcFlags>
    <ShaderOutDir>$(OutDir)Shaders\</ShaderOutDir>
  </PropertyGroup>
  <Target Name="CompileShaders" AfterTargets="ClCompile" Inputs="@(Shader)"
          Outputs="@(Shader->'$(ShaderOutDir)%(Filename)_vs.cso');@(Shader->'$(ShaderOutDir)%(Filename)_ps.cso');@(Shader->'$(ShaderOutDir)%(Filename)_vs.spv');@(Shader->'$(ShaderOutDir)%(Filename)_ps.spv')">
    <MakeDir Directories="$(ShaderOutDir)" />
    <Exec Command="&quot;$(DxcExe)&quot; $(DxcFlags) -T vs_6_0 -E VSMain -Fo &quot;$(ShaderOutDir)%(Shader.Filename)_vs.cso&quot; &quot;%(Shader.FullPath)&quot;" />
    <Exec Command="&quot;$(DxcExe)&quot; $(DxcFlags) -T ps_6_0 -E PSMain -Fo &quot;$(ShaderOutDir)%(Shader.Filename)_ps.cso&quot; &quot;%(Shader.FullPath)&quot;" />
    <Exec Command="&quot;$(DxcExe)&quot; $(DxcFlags) -spirv -T vs_6_0 -E VSMain -Fo &quot;$(ShaderOutDir)%(Shader.Filename)_vs.spv&quot; &quot;%(Shader.FullPath)&quot;" />
    <Exec Command="&quot;$(DxcExe)&quot; $(DxcFlags) -spirv -T ps_6_0 -E PSMain -Fo &quot;$(ShaderOutDir)%(Shader.Filename)_ps.spv&quot; &quot;%(Shader.FullPath)&quot;" />
  </Target>
