{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug_DX12",
            "type": "process",
            "command": "C:/Program Files/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": ["CoriumEngine.sln", "-p:Configuration=Debug_DX12", "-p:Platform=x64", "-m", "-nologo", "-v:minimal", "-property:GenerateFullPaths=true"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Build Release",
            "type": "process",
            "command": "C:/Program Files/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": ["CoriumEngine.sln", "-p:Configuration=Release", "-p:Platform=x64", "-m", "-nologo", "-v:minimal", "-property:GenerateFullPaths=true"],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Rebuild Debug_DX12",
            "type": "process",
            "command": "C:/Program Files/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": ["CoriumEngine.sln", "-t:Rebuild", "-p:Configuration=Debug_DX12", "-p:Platform=x64", "-m", "-nologo", "-v:minimal", "-property:GenerateFullPaths=true"],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Clean Debug_DX12",
            "type": "process",
            "command": "C:/Program Files/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": ["CoriumEngine.sln", "-t:Clean", "-p:Configuration=Debug_DX12", "-p:Platform=x64", "-nologo", "-v:minimal"],
            "problemMatcher": []
        }
    ]
}
