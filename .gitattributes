###############################################################################
# Global defaults
###############################################################################
* text=auto

###############################################################################
# Line endings (stable cross-platform)
###############################################################################
*.h            text eol=lf
*.hpp          text eol=lf
*.c            text eol=lf
*.cpp          text eol=lf
*.cc           text eol=lf
*.inl          text eol=lf
*.ixx          text eol=lf
*.natvis       text eol=lf
*.hlsl         text eol=lf
*.shader       text eol=lf
*.cmake        text eol=lf
CMakeLists.txt text eol=lf
*.md           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.json         text eol=lf
*.xml          text eol=lf

# Scripts
*.ps1          text eol=lf
*.sh           text eol=lf
*.cmd          text eol=crlf
*.bat          text eol=crlf

# Visual Studio / MSBuild files stay CRLF on Windows
*.sln          text eol=crlf
*.vcxproj      text eol=crlf
*.vcxproj.filters text eol=crlf
*.props        text eol=crlf
*.targets      text eol=crlf
*.rc           text eol=crlf

###############################################################################
# Safer merges for solution/project files
###############################################################################
*.sln          merge=binary
*.vcxproj      merge=binary
*.vcxproj.filters merge=binary
*.props        merge=binary
*.targets      merge=binary

###############################################################################
# Binary assets (no text normalization / no textual diff)
###############################################################################
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.bmp          binary
*.tga          binary
*.dds          binary
*.ico          binary

*.fbx          binary
*.blend        binary
*.wav          binary
*.mp3          binary
*.ogg          binary

*.zip          binary
*.7z           binary
*.rar          binary

*.dll          binary
*.exe          binary
*.lib          binary
*.pdb          binary
*.obj          binary
*.idb          binary
*.ipch         binary

###############################################################################
# Vendored/generated dependencies (GitHub stats/readability)
###############################################################################
vcpkg_installed/** linguist-vendored
